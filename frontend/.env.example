# API Configuration
VITE_API_URL=http://localhost:5000/api

# Socket.IO Configuration
VITE_SOCKET_URL=http://localhost:5000

# Google Maps API Configuration
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# OpenWeather API Configuration (optional - for weather forecasts)
VITE_OPENWEATHER_API_KEY=your_openweather_api_key_here

# Feature Flag Configuration
# Enable A/B testing for new features
VITE_AB_TEST_ENABLED=false
# Percentage of users in treatment group (0-100)
VITE_AB_TEST_TREATMENT_PERCENTAGE=50

# Analytics Configuration (PostHog)
# PostHog project API key for analytics tracking
VITE_POSTHOG_KEY=your_posthog_project_key_here
# PostHog host URL (use your self-hosted instance or app.posthog.com)
VITE_POSTHOG_HOST=https://app.posthog.com
